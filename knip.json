{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "duplicates": "error",
    "enumMembers": "error",
    "namespaceMembers": "error",
    "catalog": "error",
    "catalogReferences": "error",
    "cycles": "error"
  },
  "ignoreWorkspaces": ["packages/framework", "packages/tests", "packages/test-utils", "experiences/aricanga"],
  "ignoreDependencies": [
    "@ai-sdk/anthropic",
    "@ai-sdk/google",
    "@ai-sdk/openai",
    "@narratives/framework",
    "@narratives/test-utils",
    "@viz-js/viz",
    "ai",
    "jscpd",
    "remark-parse",
    "unified",
    "unist-util-visit",
    "xstate",
    "zod",
    "@solidjs/compiler"
  ],
  "workspaces": {
    ".": {
      "entry": ["harness/scripts/*.ts", "harness/checks/*.test.ts"],
      "project": ["harness/**/*.ts"],
      "playwright": false
    },
    "packages/foundation": {
      "project": ["src/**/*.ts!"]
    },
    "packages/systems/chat": {
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "packages/systems/cards": {
      "project": ["src/**/*.ts!"]
    },
    "experiences/sandbox": {
      "project": ["src/**/*.ts!"]
    },
    "packages/characterisation": {
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.ts"],
      "playwright": {
        "config": ["playwright.characterisation.config.ts"]
      }
    }
  }
}
