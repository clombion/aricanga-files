{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "vitest"
  ],
  "jsPlugins": [
    "eslint-plugin-solid",
    "./harness/lint-rules/plugin.ts"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "respectEslintDisableDirectives": false
  },
  "ignorePatterns": [
    "packages/framework/**",
    "packages/tests/**",
    "packages/test-utils/**",
    "experiences/aricanga/**",
    "utils/**",
    "templates/**",
    "docs/**",
    "**/dist/**",
    "**/vendor/**"
  ],
  "rules": {
    "aricanga/autofocus": "error",
    "aricanga/controlled": "error",
    "aricanga/env": ["error", { "owners": ["harness/lib/process.ts", "harness/lib/tools.ts"] }],
    "aricanga/flags": ["error", { "ignore": ["packages/characterisation/**"] }],
    "aricanga/json": "error",
    "aricanga/labels": "error",
    "aricanga/legacy": ["error", { "ignore": ["packages/characterisation/**"] }],
    "aricanga/mechanics": "error",
    "aricanga/mirrors": ["error", { "ignore": ["packages/characterisation/**"] }],
    "aricanga/promises": "error",
    "aricanga/statics": "error",
    "aricanga/store-owner": ["error", { "owners": ["**/snapshot-adapter.ts", "packages/characterisation/**"] }],
    "aricanga/style-prop": "error",
    "aricanga/sync-parts": ["error", { "ignore": ["packages/characterisation/**"] }],
    "aricanga/view-imports": "error",
    "aricanga/vm-prop": ["error", { "ignore": ["packages/characterisation/**"] }],
    "solid/jsx-no-duplicate-props": "error",
    "solid/jsx-no-undef": "error",
    "solid/jsx-uses-vars": "error",
    "solid/no-unassigned-vars": "error",
    "solid/no-unknown-namespaces": "error",
    "solid/validate-jsx-nesting": "error",
    "solid/no-innerhtml": "error",
    "solid/jsx-no-script-url": "error",
    "solid/components-return-once": "error",
    "solid/no-destructure": "error",
    "solid/prefer-for": "error",
    "solid/reactivity": "error",
    "solid/event-handlers": "error",
    "solid/imports": "error",
    "solid/style-prop": "error",
    "solid/no-react-deps": "off",
    "solid/no-react-specific-props": "error",
    "solid/self-closing-comp": "error",
    "solid/no-array-handlers": "off",
    "solid/prefer-show": "off",
    "solid/no-proxy-apis": "off",
    "solid/prefer-classlist": "off",
    "solid/removed-api": "error",
    "solid/no-single-arg-create-effect": "error",
    "solid/no-store-mutation-outside-setter": "error",
    "solid/no-write-in-pure-computation": "error",
    "solid/no-unused-signal": "error",
    "solid/no-accessor-as-prop": "error",
    "solid/no-boolean-enumerated-attribute": "error",
    "solid/prefer-structured-class": "error",
    "solid/valid-use-server": "error",
    "solid/require-async-server-function": "error",
    "solid/no-invalid-server-capture": "error",
    "solid/no-browser-globals-in-server-function": "error",
    "solid/no-module-scope-reactive-primitive": "error",
    "solid/prefer-onSettled-for-side-effects": "error",
    "solid/no-restated-default-options": "error",
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-check": false,
        "minimumDescriptionLength": 10
      }
    ],
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "eslint/no-console": "error",
    "eslint/eqeqeq": "error",
    "import/no-cycle": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error"
  },
  "overrides": [
    {
      "files": [
        "packages/foundation/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@narratives/*",
                  "sandbox",
                  "**/systems/**",
                  "**/experiences/**"
                ],
                "message": "foundation imports nothing from the rebuild (ADR-0005)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/systems/chat/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@narratives/*",
                  "!@narratives/foundation",
                  "!@narratives/foundation/*",
                  "!@narratives/system-chat",
                  "!@narratives/system-chat/*",
                  "**/experiences/**",
                  "../../*/src/**",
                  "!../../chat/src/**",
                  "../../../*/src/**",
                  "!../../../chat/src/**"
                ],
                "message": "a system imports only foundation: no other system, no experience, no POC (ADR-0005)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/systems/cards/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@narratives/*",
                  "!@narratives/foundation",
                  "!@narratives/foundation/*",
                  "!@narratives/system-cards",
                  "!@narratives/system-cards/*",
                  "**/experiences/**",
                  "../../*/src/**",
                  "!../../cards/src/**",
                  "../../../*/src/**",
                  "!../../../cards/src/**"
                ],
                "message": "a system imports only foundation: no other system, no experience, no POC (ADR-0005)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "experiences/sandbox/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@narratives/framework",
                  "@narratives/framework/*",
                  "@narratives/test-utils",
                  "@narratives/test-utils/*",
                  "**/aricanga/**",
                  "../../experiences/**"
                ],
                "message": "an experience imports foundation and systems only: no other experience, no POC (ADR-0005)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/characterisation/**",
        "harness/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@narratives/framework",
                  "@narratives/framework/*",
                  "@narratives/test-utils",
                  "@narratives/test-utils/*"
                ],
                "message": "the rebuild never imports the POC reference (ADR-0006, Scope)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/systems/*/src/system.ts",
        "packages/systems/*/src/model/**"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "Date",
            "message": "no Date in a reducer: time is simulation-derived (ADR-0007)"
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random",
            "message": "no Math.random in a reducer: ids come from ctx.nextId (ADR-0007)"
          }
        ]
      }
    }
  ]
}
