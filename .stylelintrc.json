{
  "extends": ["stylelint-config-standard"],
  "plugins": [
    "stylelint-plugin-logical-css",
    "stylelint-no-unsupported-browser-features",
    "./harness/stylelint/design-tokens.ts"
  ],
  "allowEmptyInput": true,
  "reportNeedlessDisables": true,
  "reportInvalidScopeDisables": true,
  "reportDescriptionlessDisables": true,
  "ignoreFiles": [
    "experiences/aricanga/**",
    "packages/framework/**",
    "packages/tests/**",
    "packages/test-utils/**",
    "utils/**",
    "templates/**",
    "docs/**",
    "**/dist/**",
    "**/build/**"
  ],
  "rules": {
    "logical-css/require-logical-properties": true,
    "logical-css/require-logical-keywords": true,
    "logical-css/require-logical-units": true,
    "plugin/no-unsupported-browser-features": [
      true,
      {
        "browsers": [
          "last 2 Chrome versions",
          "last 2 ChromeAndroid versions",
          "last 2 Firefox versions",
          "last 2 Safari versions",
          "last 2 iOS versions"
        ],
        "severity": "error"
      }
    ],
    "harness/design-tokens": true
  }
}
