{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "files": {
    "includes": [
      "**/*.css",
      "**/*.json",
      "!packages/framework",
      "!packages/tests",
      "!packages/test-utils",
      "!experiences/aricanga",
      "!utils",
      "!templates",
      "!docs",
      "!**/fixtures",
      "!**/__goldens__"
    ]
  }
}
