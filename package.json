{
  "name": "capital-chronicle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./harness/lib/*",
    "#checks/*": "./harness/checks/*",
    "#lint-rules/*": "./harness/lint-rules/*",
    "#scripts/*": "./harness/scripts/*"
  },
  "scripts": {
    "setup": "pnpm install --frozen-lockfile && lefthook install && node harness/scripts/gen-docs.ts",
    "check": "pnpm run check:fast && pnpm run test && pnpm run test:browser",
    "check:fast": "pnpm run lock:check && pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run dupes && pnpm run docs:check && pnpm run deadcode && pnpm run build:check",
    "lock:check": "pnpm install --frozen-lockfile --lockfile-only",
    "lint": "pnpm run lock:check && oxlint && stylelint \"**/*.css\" --max-warnings 0",
    "format:check": "pnpm run lock:check && oxfmt --check",
    "typecheck": "pnpm run lock:check && node harness/scripts/typecheck.ts",
    "dupes": "pnpm run lock:check && node harness/scripts/dupes.ts",
    "docs:check": "pnpm run lock:check && node harness/scripts/gen-docs.ts --check",
    "deadcode": "pnpm run lock:check && knip --production --treat-config-hints-as-errors && knip --treat-config-hints-as-errors",
    "build:check": "pnpm run lock:check && node harness/scripts/build-check.ts",
    "test": "pnpm run lock:check && vitest run --config vitest.gate.config.ts --coverage && node harness/scripts/coverage-floor.ts",
    "test:browser": "pnpm run lock:check && playwright test -c packages/characterisation/playwright.characterisation.config.ts --grep-invert @performance && playwright test -c packages/characterisation/playwright.characterisation.config.ts --grep @performance --workers=1",
    "test:stress": "pnpm run lock:check && node harness/scripts/stress.ts",
    "fix": "oxlint --fix && oxfmt && node harness/scripts/gen-docs.ts",
    "characterise:baseline": "node harness/scripts/performance-baseline.ts",
    "vite": "vite",
    "vite:build": "vite build",
    "vite:preview": "vite preview",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:engine": "playwright test --project=engine",
    "test:impl": "playwright test --project=implementation",
    "test:quality": "playwright test --project=quality",
    "test:mobile": "playwright test --project='Mobile Safari'",
    "test:a11y": "playwright test packages/tests/quality/accessibility/accessibility.spec.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "playwright:install": "playwright install",
    "lint:tags": "bash experiences/aricanga/utils/ink/lint-tags.sh",
    "lint:image-paths": "bash experiences/aricanga/utils/ink/lint-image-paths.sh",
    "lint:ink-comments": "bash experiences/aricanga/utils/ink/lint-ink-comments.sh",
    "lint:time-tags": "node experiences/aricanga/utils/ink/lint-time-tags.js",
    "lint:locale-parity": "node experiences/aricanga/utils/ink/lint-locale-parity.js",
    "lint:i18n-parity": "node experiences/aricanga/utils/ink/lint-i18n-parity.js",
    "lint:glossary-parity": "node experiences/aricanga/utils/ink/lint-glossary-parity.js",
    "lint:link-preview": "node experiences/aricanga/utils/ink/lint-link-preview.js",
    "lint:config-ink": "node experiences/aricanga/utils/ink/lint-config-ink.js",
    "lint:current-chat": "bash experiences/aricanga/utils/ink/lint-current-chat.sh",
    "lint:cross-chat": "bash experiences/aricanga/utils/ink/lint-cross-chat.sh",
    "lint:css": "bash experiences/aricanga/utils/implementation/lint-css.sh",
    "lint:toml": "node experiences/aricanga/utils/ink/lint-toml.js",
    "lint:dom": "node utils/linting/source/lint-dom.js",
    "lint:svg-a11y": "node utils/linting/source/lint-svg-a11y.js",
    "lint:globals": "node utils/linting/source/lint-globals.js",
    "lint:events": "node utils/linting/source/lint-events.js",
    "lint:ink-access": "node experiences/aricanga/utils/implementation/lint-ink-access.js",
    "lint:doc-links": "node utils/linting/repo/lint-doc-links.js",
    "lint:imports": "node utils/linting/source/lint-imports.js",
    "lint:component-registration": "node utils/linting/source/lint-component-registration.js",
    "lint:transition-safety": "node utils/linting/source/lint-transition-safety.js",
    "lint:test-paths": "node utils/linting/repo/lint-test-paths.js",
    "lint:file-structure": "node utils/linting/repo/lint-file-structure.js",
    "lint:action-guards": "node experiences/aricanga/utils/implementation/lint-action-guards.js",
    "lint:component-params": "node experiences/aricanga/utils/implementation/lint-component-params.js",
    "lint:import-graph": "node utils/linting/repo/lint-import-graph.js",
    "lint:barrel-completeness": "node utils/linting/repo/lint-barrel-completeness.js",
    "lint:export-parity": "node utils/linting/repo/lint-export-parity.js --compare",
    "lint:export-parity:snapshot": "node utils/linting/repo/lint-export-parity.js --snapshot",
    "lint:event-wiring": "node utils/linting/repo/lint-event-wiring.js",
    "lint:event-wiring:snapshot": "node utils/linting/repo/lint-event-wiring.js --snapshot",
    "lint:test-assumptions": "node utils/linting/repo/lint-test-assumptions.js",
    "lint:test-assumptions:warnings": "node utils/linting/repo/lint-test-assumptions.js --warnings",
    "lint:doc-code-refs": "node utils/linting/repo/lint-doc-code-refs.js",
    "lint:html-imports": "node utils/linting/repo/lint-html-imports.js",
    "lint:test-parity": "node utils/linting/repo/lint-test-parity.js --compare",
    "lint:test-parity:snapshot": "node utils/linting/repo/lint-test-parity.js --snapshot",
    "lint:workspace-resolution": "node utils/linting/repo/lint-workspace-resolution.js",
    "lint:path-mapping": "node utils/linting/repo/lint-path-mapping.js",
    "lint:seeds": "node utils/linting/repo/lint-seeds.js",
    "lint:external-functions": "node utils/linting/repo/lint-external-functions.js",
    "lint:tags:compiled": "node experiences/aricanga/utils/qa/ink-tag-audit.js",
    "test:poc": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.122",
    "@viz-js/viz": "^3.31.0",
    "xstate": "^5.33.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.106",
    "@ai-sdk/openai": "^4.0.121",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@double-great/stylelint-a11y": "3.8.3",
    "@iarna/toml": "^2.2.5",
    "@narratives/framework": "workspace:*",
    "@narratives/test-utils": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@types/iarna__toml": "^2.0.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "ai": "^7.0.177",
    "eslint": "^10.15.0",
    "eslint-plugin-solid": "0.20.0",
    "fast-check": "^4.10.3",
    "happy-dom": "^21.0.4",
    "inkjs": "^2.4.0",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.5",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "stylelint-no-unsupported-browser-features": "8.1.2",
    "stylelint-order": "8.1.3",
    "stylelint-plugin-logical-css": "2.1.0",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
