// path: harness/lib/statics-clean.ts
export class Clock {
  public static readonly origin: number = Number.MIN_SAFE_INTEGER;

  public readonly offset: number;

  public constructor(offset: number) {
    this.offset = offset;
  }

  public static start(): number {
    return Clock.origin;
  }

  public read(): number {
    return Clock.origin + this.offset;
  }
}
