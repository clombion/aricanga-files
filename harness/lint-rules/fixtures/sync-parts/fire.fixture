// path: packages/systems/chat/src/view/sync-parts-fire.tsx
import type { JSX } from '@solidjs/web';

export function Bubble(props: { readonly vm: { readonly text: Readonly<Promise<string>> } }): JSX.Element {
  let shown = '';
  props.vm.text
    .then((text) => {
      shown = text;
      return text;
    })
    .catch(() => '');
  return <p>{shown}</p>;
}
