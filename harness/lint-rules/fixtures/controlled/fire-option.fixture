// path: packages/systems/chat/src/view/controlled-option-fire.tsx
import type { JSX } from 'solid-js';

export function Stuck(props: { readonly vm: { readonly choice: string } }): JSX.Element {
  return (
    <select>
      <option value="b" selected={props.vm.choice === 'b'}>
        b
      </option>
    </select>
  );
}
