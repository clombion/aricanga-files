// path: packages/systems/chat/src/view/controlled-clean.tsx
import type { JSX } from 'solid-js';

function Draft(props: { readonly vm: { readonly text: string; readonly edit: (text: string) => void } }): JSX.Element {
  return (
    <input
      value={props.vm.text}
      onInput={(event: Readonly<{ currentTarget: Readonly<{ value: string }> }>) => {
        props.vm.edit(event.currentTarget.value);
      }}
    />
  );
}

function Seed(props: { readonly vm: { readonly text: string } }): JSX.Element {
  return <input defaultValue={props.vm.text} />;
}

export { Draft, Seed };
