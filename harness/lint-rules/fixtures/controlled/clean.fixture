// path: packages/systems/chat/src/view/controlled-clean.tsx
export function Draft(props: { vm: { text: string; edit: (text: string) => void } }) {
  return <input value={props.vm.text} onInput={(event) => props.vm.edit(event.currentTarget.value)} />;
}

export function Seed(props: { vm: { text: string } }) {
  return <input defaultValue={props.vm.text} />;
}
