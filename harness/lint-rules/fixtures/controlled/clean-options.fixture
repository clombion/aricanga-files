// path: packages/systems/chat/src/view/controlled-options.tsx
import type { JSX } from 'solid-js';

function Picker(props: { readonly vm: { readonly choice: string; readonly pick: (choice: string) => void } }): JSX.Element {
  return (
    <select
      onChange={(event: Readonly<{ currentTarget: Readonly<{ value: string }> }>) => {
        props.vm.pick(event.currentTarget.value);
      }}
    >
      <option value="a">a</option>
      <option value="b" selected={props.vm.choice === 'b'}>
        b
      </option>
    </select>
  );
}

function Seeded(): JSX.Element {
  return <input value="seed" />;
}

export { Picker, Seeded };
