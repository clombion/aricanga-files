// path: packages/systems/chat/src/view/flags-fire.tsx
import type { JSX } from '@solidjs/web';
import { createSignal } from 'solid-js';

export function Thread(props: { readonly vm: { readonly title: string } }): JSX.Element {
  const [loading, setLoading] = createSignal(true);
  return (
    <button type="button" onClick={() => {
        setLoading(false);
      }}>
      {loading() ? '…' : props.vm.title}
    </button>
  );
}
