// path: packages/systems/chat/src/view/mirrors-fire.tsx
import { createEffect, createSignal } from 'solid-js';
import type { JSX } from '@solidjs/web';

export function Title(props: { readonly vm: { readonly title: string } }): JSX.Element {
  const [shown, setShown] = createSignal('');
  createEffect(
    () => props.vm.title,
    (title) => {
      setShown(title);
    },
  );
  return <h1>{shown()}</h1>;
}
