// path: packages/systems/chat/src/view/vm-prop-clean.tsx
import type { JSX } from 'solid-js';

const MINUTES_PER_HOUR = 60;

function Bubble(props: { readonly vm: { readonly text: string } }): JSX.Element {
  return <p>{props.vm.text}</p>;
}

const Divider = (): JSX.Element => <hr />;

function formatTime(minutes: number): string {
  return `${Math.floor(minutes / MINUTES_PER_HOUR)}:${minutes % MINUTES_PER_HOUR}`;
}

const Stamp = (props: { readonly vm: { readonly minutes: number } }): JSX.Element => <time>{formatTime(props.vm.minutes)}</time>;

export { Bubble, Divider, Stamp };
