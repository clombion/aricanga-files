{
  "name": "@narratives/characterisation",
  "version": "0.1.0",
  "private": true,
  "description": "Step 1 of Phase 3: real-browser characterisation of Solid 2.0 runtime behaviour against the pinned versions. Each [verify]/[known] claim from the Solid-2.0 view-layer brief is a test here, run in Chromium, Firefox and WebKit.",
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    "./browsers": "./browsers.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "characterise": "playwright test -c playwright.characterisation.config.ts",
    "characterise:report": "playwright show-report .output/report"
  },
  "dependencies": {
    "@solidjs/web": "catalog:",
    "solid-js": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@solidjs/compiler": "catalog:",
    "@solidjs/vite-plugin": "catalog:"
  },
  "aricanga": {
    "role": "test-infrastructure"
  }
}
